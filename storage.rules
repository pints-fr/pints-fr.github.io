rules_version = '2';

// Four things live in the bucket: figures attached to abstracts, the
// photographs behind the home page hero, the archive albums, and images in
// page copy.
//
// Storage rules cannot read Firestore, so ownership has to be encoded in the
// object path — hence abstract_figures/{uid}/{abstractId}, not a flat namespace
// keyed by abstract id alone. js/figure-utils.mjs figurePath(),
// js/hero-utils.mjs heroPath(), js/album-utils.mjs archivePath() and
// js/page-image-utils.mjs pageImagePath() are the single places that build them.

service firebase.storage {
  match /b/{bucket}/o {

    match /abstract_figures/{uid}/{fileName} {
      // Figures are for the organizers and reviewers only: the public abstract
      // list never shows one (js/abstract-utils.mjs publicFields()). So a read
      // by path is the uploader's alone. The admin console still shows every
      // figure, because it loads the stored figureUrl — a download URL that
      // carries its own token, which Firebase honours whatever these rules say.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Mirrors js/figure-utils.mjs validateFigure(). The client downscales
      // first, so a legitimate upload lands far under this ceiling; the limit is
      // here to stop someone using the bucket as free hosting.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photographs behind the home page hero, uploaded from the admin console.
    //
    // The uid in the path is the strongest check available here: these rules
    // cannot ask whether the uploader is an organizer, so a signed-in
    // participant could write under their own uid. That gets them nothing —
    // putting a photograph on the home page needs a write to config/hero, and
    // firestore.rules gates that on isAdmin() — but it is why the size and type
    // limits below matter as much as they do for figures.
    match /hero/{uid}/{fileName} {
      // The home page is public, so its photographs are.
      allow read: if true;

      // Same ceiling as a figure. The client downscales to HERO.maxEdge first,
      // so a real upload lands far under it.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photographs in the archive albums, uploaded from the admin console.
    //
    // A separate prefix from hero/ rather than a shared one, and the prefix is
    // the delete permission: js/album-utils.mjs ownsObject() only lets the
    // Archive tab delete what it uploaded itself. A photograph imported from the
    // home page keeps its hero/ path and stays on both lists as one object, so
    // removing it from an album must not take it off the home page.
    //
    // Same reasoning as hero/ on why the uid is the only check available here:
    // these rules cannot ask whether the uploader is an organizer, and putting
    // a photograph on the public Archive page needs a write to gallery/{year},
    // which firestore.rules gates on isAdmin().
    match /archive/{uid}/{fileName} {
      // The Archive page is public, so its photographs are.
      allow read: if true;

      // Same ceiling as a figure. The client downscales to ARCHIVE.maxEdge
      // first, so a real upload lands far under it.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Images in page copy, uploaded from the admin console's Pages tab.
    //
    // Same reasoning as hero/ on why the uid is the only check available here:
    // an upload alone shows nowhere. Putting an image on a public page needs a
    // write to pages/{slug}, which firestore.rules gates on isAdmin().
    match /page_images/{uid}/{fileName} {
      // Page copy is public, so its images are.
      allow read: if true;

      // Same ceiling as a figure. The client downscales to PAGE_IMAGE.maxEdge
      // first, so a real upload lands far under it.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Anything not matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
